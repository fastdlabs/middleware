{
    "name": "fastd/middleware",
    "description": "PSR-15 HTTP middleware stack for FastD.",
    "license": "MIT",
    "authors": [
        {
            "name": "JanHuang",
            "email": "384099566@qq.com"
        }
    ],
    "require": {
        "php": ">=8.4.1",
        "fastd/http": "^8.0",
        "psr/http-server-middleware": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "FastD\\Middleware\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage/"
    }
}
