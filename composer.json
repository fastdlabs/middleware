    "require": {
        "php": ">=8.2",
        "fastd/http": "^8.0",
        "psr/http-server-middleware": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "FastD\\Middleware\\": "src"
        }
